APP_NAME="Veggie Rescue Deliveries API"
APP_ENVIRONMENT="development"
DEBUG="false"

# Copy the direct development-branch connection string from Neon into .env.
# Change postgresql:// to postgresql+psycopg://
DATABASE_URL="postgresql+psycopg://NEON_ROLE:NEON_PASSWORD@NEON_HOST/neondb?sslmode=require&channel_binding=require"